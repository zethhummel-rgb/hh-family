{
  "name": "hh-family-pilot",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:calendar": "node scripts/check-calendar.mjs && node scripts/check-calendar-auth.mjs && node scripts/check-calendar-recurrence.mjs && node scripts/check-people.mjs && node scripts/check-reminders.mjs && node scripts/check-pilot.mjs",
    "test:database": "node scripts/check-pilot-database.mjs",
    "test:invitations": "node scripts/check-invitation-email.mjs",
    "test:recovery": "node scripts/check-password-recovery.mjs",
    "test:welcome": "node scripts/check-welcome-tour.mjs && node scripts/check-family-setup.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
